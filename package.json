{
    "name": "acuity-ledger",
    "version": "1.0.0",
    "description": "Acuity Ledger — Commodity Trading P&L",
    "main": "main.js",
    "author": "Acuity Ledger",
    "scripts": {
        "start": "electron .",
        "pack": "npx @electron/packager . \"Acuity Ledger\" --platform=win32 --arch=x64 --out=dist-build --overwrite --ignore=\"\\.zip$\" --ignore=\"stitch_output\" --ignore=\"node_modules/7zip-bin\" && powershell -NoProfile -ExecutionPolicy Bypass -File sign-build.ps1 -FilePath \"dist-build\\Acuity Ledger-win32-x64\\Acuity Ledger.exe\"",
        "dist": "npx electron-builder build --win --config && powershell -NoProfile -ExecutionPolicy Bypass -File sign-dist.ps1"
    },
    "build": {
        "appId": "com.acuity-ledger.app",
        "productName": "Acuity Ledger",
        "directories": {
            "output": "dist-installer"
        },
        "files": [
            "*.html",
            "*.js",
            "*.css",
            "*.json",
            "!node_modules/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": ["x64"]
                }
            ],
            "icon": null,
            "signAndEditExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Acuity Ledger",
            "uninstallDisplayName": "Acuity Ledger",
            "installerIcon": null,
            "uninstallerIcon": null
        }
    },
    "devDependencies": {
        "@electron/packager": "^20.0.0",
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0",
        "electron-packager": "^17.1.2"
    }
}
